    "    \"\\n\",\n",
    "    \"        all_rows.extend(kw_rows)\\n\",\n",
    "    \"        per_keyword_counts[keyword] = len(kw_rows)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # --- progress line with count, timing, running total, and ETA ---\\n\",\n",
    "    \"        kw_elapsed = time.time() - kw_start\\n\",\n",
