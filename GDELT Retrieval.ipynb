    "    \"          f\\\"{dict(df['domain'].value_counts()) if len(df) else {}}\\\")\\n\",\n",
    "    \"    top = sorted(per_keyword_counts.items(), key=lambda x: -x[1])[:3]\\n\",\n",
    "    \"    print(f\\\"  top keywords       : {top}\\\")\\n\",\n",
