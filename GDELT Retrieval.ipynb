    "    \"                f'<a href=\\\"{CODE_URL_GITHUB}\\\" target=\\\"_blank\\\">'\\n\",\n",
    "    \"                f'{CODE_URL_GITHUB}</a></p>')\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        html = (f'<p><b>Source code (local):</b> '\\n\",\n",
    "    \"                f'<code>{CODE_PATH_LOCAL}</code><br>'\\n\",\n",
    "    \"                f'<i>Local paths are not clickable outside your computer; '\\n\",\n",
    "    \"                f'switch to the GitHub link for a shareable report.</i></p>')\\n\",\n",
