    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"from IPython.display import HTML, display\\n\",\n",
    "    \"\\n\",\n",
    "    \"def show_code_link():\\n\",\n",
    "    \"    \\\"\\\"\\\"Display a clickable link to the project code (GitHub or local).\\\"\\\"\\\"\\n\",\n",
