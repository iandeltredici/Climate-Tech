    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from IPython.display import clear_output, display\\n\",\n",
    "    \"\\n\",\n",
    "    \"def format_seconds(sec):\\n\",\n",
    "    \"    \\\"\\\"\\\"Turn a number of seconds into a short human-readable string.\\\"\\\"\\\"\\n\",\n",
    "    \"    if sec < 60:\\n\",\n",
    "    \"        return f\\\"{sec:.0f}s\\\"\\n\",\n",
    "    \"    if sec < 3600:\\n\",\n",
    "    \"        return f\\\"{sec/60:.1f} min\\\"\\n\",\n",
    "    \"    return f\\\"{sec/3600:.1f} hr\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def _live_dashboard(df, i, n_keywords, per_keyword_counts, elapsed, eta):\\n\",\n",
    "    \"    \\\"\\\"\\\"Refresh a live view in place: progress line, a chart, and a table.\\n\",\n",
    "    \"    Only meaningful when run interactively in Jupyter.\\\"\\\"\\\"\\n\",\n",
    "    \"    clear_output(wait=True)                 # erase the previous frame\\n\",\n",
    "    \"    print(f\\\"Progress: {i}/{n_keywords} keywords | \\\"\\n\",\n",
    "    \"          f\\\"{len(df)} articles so far | elapsed {elapsed} | ETA {eta}\\\")\\n\",\n",
    "    \"    if len(df):\\n\",\n",
    "    \"        fig, ax = plt.subplots(1, 2, figsize=(11, 3.2))\\n\",\n",
    "    \"        df[\\\"domain\\\"].value_counts().plot(\\n\",\n",
    "    \"            kind=\\\"bar\\\", ax=ax[0], color=\\\"#2b6cb0\\\")\\n\",\n",
    "    \"        ax[0].set_title(\\\"Articles by family\\\"); ax[0].set_xlabel(\\\"\\\")\\n\",\n",
    "    \"        top = (pd.Series(per_keyword_counts).sort_values(ascending=False)\\n\",\n",
    "    \"               .head(8).iloc[::-1])\\n\",\n",
    "    \"        top.plot(kind=\\\"barh\\\", ax=ax[1], color=\\\"#38a169\\\")\\n\",\n",
    "    \"        ax[1].set_title(\\\"Top keywords so far\\\")\\n\",\n",
    "    \"        plt.tight_layout(); plt.show()\\n\",\n",
    "    \"        display(df.tail(5))                 # newest rows as a live table\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def retrieve_all(keyword_pairs, start_date, end_date,\\n\",\n",
    "    \"                 delay=REQUEST_DELAY, save_per_keyword=True, live=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"Retrieve filtered articles for every keyword across the full date range.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Loops over every keyword, then over every monthly window. Prints progress,\\n\",\n",
    "    \"    running counts, and timing so you can see exactly what is happening.\\n\",\n",
    "    \"    If save_per_keyword is True, writes one raw CSV per keyword as it finishes\\n\",\n",
    "    \"    (into raw_by_keyword/) so an interrupted run can resume.\\n\",\n",
    "    \"    Returns one combined DataFrame.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    if live is None:\\n\",\n",
    "    \"        live = LIVE_DISPLAY\\n\",\n",
    "    \"    windows = list(month_windows(start_date, end_date))\\n\",\n",
    "    \"    n_keywords = len(keyword_pairs)\\n\",\n",
    "    \"    if save_per_keyword:\\n\",\n",
    "    \"        os.makedirs(\\\"raw_by_keyword\\\", exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"=\\\" * 60)\\n\",\n",
    "    \"    print(f\\\"STARTING RETRIEVAL\\\")\\n\",\n",
    "    \"    print(f\\\"  keywords to search : {n_keywords}\\\")\\n\",\n",
